# ISP Onboarding & Partner Gateway Environment Configuration

PORT=8081
DB_DRIVER=sqlite
DATABASE_URL=onboarding.db

# Batas maksimal jarak tarikan kabel dropcore dari ODP (meter)
MAX_COVERAGE_METERS=250.0

# Kredensial Core Billing (GOGIGABILL)
GIGABILL_BASE_URL=http://localhost:8080
GIGABILL_API_TOKEN=supersecret-admin-token

# Admin Security Key
ADMIN_API_KEY=isp-onboarding-admin-key
